<<video_jdsmodel_nlapses_8ses, cache=TRUE ,echo=FALSE, warning=FALSE, message=FALSE>>=


####################### forward- backward variable selection ###################
# jds original model formula
statelapses_imf <- formula(paste0('statelapse_code',"~", paste0(indep_var, collapse = "+")))

# jdsa full model
statelapses_full_mod <- ols(statelapses_imf, data= sm_8ses_mdt2)

# extract dependent variable from formula
statelapses_dep_var <- all.vars(update(statelapses_imf,.~0))

# check if there is multicollinearity issue/ offending variables exits. 
# The offending variables coeffcients are not estimating and dropped from analysis
  if(any(is.na(statelapses_full_mod$coefficients))==TRUE){
    # model with non-offending  predictors
    statelapses_imf_new <- formula(paste0(statelapses_dep_var, "~", 
                                         paste0(names(statelapses_full_mod$coefficients[!is.na(statelapses_full_mod$coefficients)])[-1], collapse="+")))
    # fit new full model after dropping offending variables 
    statelapses_full_mod_new <- ols(statelapses_imf_new, data=sm_8ses_mdt2) 
  } else{
  # if no offending variables exists use the full.mod
    statelapses_imf_new <- statelapses_imf
    statelapses_full_mod_new <- statelapses_full_mod
  }
  # Perform backward elimination for model persimony	
  statelapses_step_mod <- fastbw(statelapses_full_mod_new, rule='p', type='individual', sls=0.05) 
  # final model formula
  statelapses_imf_final <- formula(paste0(statelapses_dep_var, "~", paste0(statelapses_step_mod$names.kept, collapse="+")))
  # final model after variable selection /backward elimination
  statelapses_final_mod <- ols(statelapses_imf_final, data=sm_8ses_mdt2)


# calculate jds values
sm_8ses_mdt$statelapse_jds <- predict(statelapses_final_mod, newdata=sm_8ses_mdt)  
  
# truncate to have values in between 0 (values <0 to 0) and 10 (values > 10 to 10)
sm_8ses_mdt$statelapse_jds[sm_8ses_mdt$statelapse_jds <= 0] <- 0
sm_8ses_mdt$statelapse_jds[sm_8ses_mdt$statelapse_jds >= 10] <- 10



