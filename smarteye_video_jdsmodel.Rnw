\subsection[Linear video model using lapsing minutes]{Video JDS for SmartEye using lapsing minute}

<<video_nlapses_allocation, cache=TRUE ,echo=FALSE, warning=FALSE, message=FALSE>>=

sm_mdt$statelapse <- NA   

sm_mdt$statelapse[sm_mdt$state20min =="not_impaired" & sm_mdt$lapsing_minute =="no"] <-  "not_impaired_not_lapsing"
sm_mdt$statelapse[sm_mdt$state20min =="not_impaired" & sm_mdt$lapsing_minute =="yes"] <-  "not_impaired_lapsing"
sm_mdt$statelapse[sm_mdt$state20min =="impaired" & sm_mdt$lapsing_minute =="no"] <-  "impaired_not_lapsing"
sm_mdt$statelapse[sm_mdt$state20min =="impaired" & sm_mdt$lapsing_minute =="yes"] <-  "impaired_lapsing"

sm_mdt$statelapse <- factor(sm_mdt$statelapse, levels =c("not_impaired_not_lapsing", "not_impaired_lapsing","impaired_not_lapsing","impaired_lapsing"))

# statelapse code: alert = -1 and drowsy = 8
sm_mdt$statelapse_code <- 100
sm_mdt$statelapse_code[sm_mdt$statelapse =="not_impaired_not_lapsing"] <- -1
sm_mdt$statelapse_code[sm_mdt$statelapse =="impaired_lapsing"] <- 9

####### subset data to have only statelapse_code 
sm_mdt2 <- sm_mdt[sm_mdt$statelapse %in% c("not_impaired_not_lapsing","impaired_lapsing"),] 

