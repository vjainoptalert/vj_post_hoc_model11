        facet_wrap(~ state+ type,  labeller = label_both )  +
        stat_smooth(method = "lm", col="red") +  
        ggtitle("Device: Glasses \nRelationship between Amplitude and Velocity (8 sessions combined)") +
        theme_bw() +
        theme( plot.title = element_text(size=14, hjust = 0.5, face="bold"))
        

##################### slope ,correlation ##################
sm_gl_stat1 <- 
  sm_gl_dt %>%
  group_by(state, type) %>%
  do(mod1 = lm(maxamp~maxvel, data = .), 
     mod2 = cor(.$maxamp, .$maxvel, method = "pearson"),
     mod3 = nrow(.)) %>%
  mutate(n_events = mod3[[1]],
         slope = round(summary(mod1)$coeff[2],3), 
         correlation = round(mod2[1],3)) %>%
       select(-mod1, -mod2, -mod3) %>%
       arrange(type)


#### mean & sd of avr #######################
sm_gl_stat2 <- 
  sm_gl_dt %>%
  group_by(state, type) %>%
  summarise(mean_avr = round(mean(avr),3), 
            sd_avr = round(sd(avr),3)) %>% 
  arrange(type)

### combine stat file #####################
sm_gl_stat3 <- data.frame("device" = "Glasses", right_join(sm_gl_stat1, sm_gl_stat2, by=c("state","type")) )

