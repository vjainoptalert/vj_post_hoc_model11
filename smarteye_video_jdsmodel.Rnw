\subsubsection{Model with number of lapses using 8 sessions}

<<video_nlapses_allocation_8ses, cache=TRUE ,echo=FALSE, warning=FALSE, message=FALSE>>=

sm_8ses_mdt$statelapse <- NA   

sm_8ses_mdt$statelapse[sm_8ses_mdt$state20min =="not_impaired" & sm_8ses_mdt$lapsing_minute =="no"] <-  "not_impaired_not_lapsing"
sm_8ses_mdt$statelapse[sm_8ses_mdt$state20min =="not_impaired" & sm_8ses_mdt$lapsing_minute =="yes"] <-  "not_impaired_lapsing"
sm_8ses_mdt$statelapse[sm_8ses_mdt$state20min =="impaired" & sm_8ses_mdt$lapsing_minute =="no"] <-  "impaired_not_lapsing"
sm_8ses_mdt$statelapse[sm_8ses_mdt$state20min =="impaired" & sm_8ses_mdt$lapsing_minute =="yes"] <-  "impaired_lapsing"

sm_8ses_mdt$statelapse <- factor(sm_8ses_mdt$statelapse, levels =c("not_impaired_not_lapsing", "not_impaired_lapsing","impaired_not_lapsing","impaired_lapsing"))

# statelapse code: alert = -1 and drowsy = 8
sm_8ses_mdt$statelapse_code <- 100
sm_8ses_mdt$statelapse_code[sm_8ses_mdt$statelapse =="not_impaired_not_lapsing"] <- -1
sm_8ses_mdt$statelapse_code[sm_8ses_mdt$statelapse =="impaired_lapsing"] <- 9

####### subset data to have only statelapse_code 
sm_8ses_mdt2 <- sm_8ses_mdt[sm_8ses_mdt$statelapse %in% c("not_impaired_not_lapsing","impaired_lapsing"),] 

