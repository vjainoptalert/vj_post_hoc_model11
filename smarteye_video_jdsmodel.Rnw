<<smarteye_videomodel_2, cache=TRUE, echo=FALSE, warning=FALSE, message=FALSE>>=
################# fit a  model with state20min #################
# jdsa full model
state20min_full_mod_8ses <- ols(state20min_imf, data= sm_8ses_mdt)


# check if there is multicollinearity issue/ offending variables exits. 
# The offending variables coeffcients are not estimating and dropped from analysis
  if(any(is.na(state20min_full_mod_8ses$coefficients))==TRUE){
    # model with non-offending  predictors
    state20min_imf_new_8ses <- formula(paste0(state20min_dep_var, "~", 
                                         paste0(names(state20min_full_mod_8ses$coefficients[!is.na(state20min_full_mod_8ses$coefficients)])[-1], collapse="+")))
    # fit new full model after dropping offending variables 
    state20min_full_mod_new_8ses <- ols(state20min_imf_new_8ses, data=sm_8ses_mdt) 
  } else{
  # if no offending variables exists use the full.mod
    state20min_imf_new_8ses <- state20min_imf
    state20min_full_mod_new_8ses <- state20min_full_mod_8ses
  }
  # Perform backward elimination for model persimony	
  state20min_step_mod_8ses <- fastbw(state20min_full_mod_new_8ses, rule='p', type='individual', sls=0.05) 
  # final model formula
  state20min_imf_final_8ses <- formula(paste0(state20min_dep_var, "~", paste0(state20min_step_mod_8ses$names.kept, collapse="+")))
  # final model after variable selection /backward elimination
  state20min_final_mod_8ses <- ols(state20min_imf_final_8ses, data=sm_8ses_mdt)

############ calculate JDS Raw ###############
# calculate jds values
sm_8ses_mdt$state20min_8ses_jds <- predict(state20min_final_mod_8ses, data = sm_8ses_mdt)  
  
# truncate to have values in between 0 (values <0 to 0) and 10 (values > 10 to 10)
sm_8ses_mdt$state20min_8ses_jds[sm_8ses_mdt$state20min_8ses_jds <= 0] <- 0
sm_8ses_mdt$state20min_8ses_jds[sm_8ses_mdt$state20min_8ses_jds >= 10] <- 10




@


