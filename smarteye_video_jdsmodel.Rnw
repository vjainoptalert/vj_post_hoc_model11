<<risk_per_minute_plot_all, cache=TRUE, echo=FALSE, warning=FALSE, message=FALSE, fig.show= 'asis', fig.align='center', fig.height = 4.5>>=

#bin predicted JDS score in binwidth of 
bin_low <- seq(0,9,1)
bin_up <- c(seq(0.9,8.9,1),10) 

# classify them according to the bin
sm_mdt$statelapsejds_bin <- cut(round(sm_mdt$statelapse_jds,1), breaks = c(0,bin_up), right = TRUE, include.lowest = TRUE)
sm_mdt$statelapsejds_bin_name <- factor(sm_mdt$statelapsejds_bin , labels = c(1:10))

# calculate percentage of minute with at least one lapse that falls within each score group 
# relative risk?? 

rr_jds <- 
  sm_mdt %>%
  group_by(statelapsejds_bin_name) %>%
  summarise(total_minute = length(n_lapses),
            n_lapsing_minute = sum(n_lapses> 0)) %>%
  mutate(lapsing_minute_perc = round(100*n_lapsing_minute/total_minute, 1))

#################################################################################
# bar plot of percentage of lasping minute that falls wihtin each score group

# draw a box width = 2.64 and height = 2.01
# plot(x = seq(0, 12,length.out = 17),
#      y = seq(0, 80, by=5), 
#      ylab = "Holes searched before target",
#      xlab = "",
#      axes = FALSE,
#      type="n")

# bar data
bardt <- rr_jds

# calculate top of each bar to print text
bartopText.y <-bardt$lapsing_minute_perc + 7

score_plot1 <- barplot(height=bardt$lapsing_minute_perc, 
               ylim = c(0,80),
               col = c("green", "green","green", "green","yellow","tomato", "tomato","tomato","tomato","tomato"),
               xlab = "Raw JDS score",
               ylab = "% minute with at least one lapse",
               main = paste0("Validation of JDS score from ", model_device, "(", n_session_final, " sessions) \n (TM = Total minute; TLM = Total lapsing minute)"),
               font.main = 1)

# x-axis line. lwd controls width of the line. 
lines(x=c(-0.5,length(bardt)+3), y=c(0,0), lwd=1)

# text on top of each bar
text(x = score_plot1, 
     y = bartopText.y,
     pos = 1,
     offset = 0.2,
     labels = paste0("TM= ",bardt$total_minute,"\n","TLM= ", bardt$n_lapsing_minute), 
     cex = 0.6)  

# xaxis label
axis(side=1, at = score_plot1, labels = c("0-0.9", "1-1.9", "2-2.9", "3-3.9","4-4.9", "5-5.9","6-6.9","7-7.9","8-8.9","9-10"),
     cex.axis = 0.8)


@

